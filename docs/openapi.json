 "components": {
  "schemas": {
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "InferIn": {
    "properties": {
     "kind": {
      "type": "string",
      "const": "acoustic",
      "title": "Kind",
      "description": "Only sounds: no image is analysed in this build"
     },
     "features": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "maxItems": 5,
      "minItems": 5,
      "title": "Features",
      "description": "duration s, rise s, peak Hz, bandwidth Hz, level dB"
     }
    },
    "type": "object",
    "required": [
     "kind",
     "features"
    ],
    "title": "InferIn"
   },
   "Obs": {
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "animal",
       "vehicle",
       "sound"
      ],
      "title": "Kind"
     },
     "day": {
      "type": "integer",
      "maximum": 400.0,
      "minimum": 0.0,
      "title": "Day"
     },
     "hour": {
      "type": "number",
      "exclusiveMaximum": 24.0,
      "minimum": 0.0,
      "title": "Hour"
     },
     "label": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 40
       },
       {
        "type": "null"
       }
      ],
      "title": "Label"
     },
     "confidence": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 1.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Confidence"
     },
     "count": {
      "type": "integer",
      "maximum": 500.0,
      "minimum": 1.0,
      "title": "Count",
      "default": 1
     },
     "features": {
      "anyOf": [
       {
        "items": {
         "type": "number"
        },
        "type": "array",
        "maxItems": 5,
        "minItems": 5
       },
       {
        "type": "null"
       }
      ],
      "title": "Features",
      "description": "Sounds only: duration s, rise s, peak Hz, bandwidth Hz, level dB"
     }
    },
    "type": "object",
    "required": [
     "kind",
     "day",
     "hour"
    ],
    "title": "Obs"
   },
   "PatrolIn": {
    "properties": {
     "teams": {
      "type": "integer",
      "maximum": 8.0,
      "minimum": 1.0,
      "title": "Teams",
      "default": 3
     },
     "hours": {
      "type": "number",
      "maximum": 14.0,
      "minimum": 2.0,
      "title": "Hours",
      "default": 8.0
     }
    },
    "type": "object",
    "title": "PatrolIn"
   },
   "SyncIn": {
    "properties": {
     "seq": {
      "type": "integer",
      "maximum": 100000.0,
      "minimum": 0.0,
      "title": "Seq",
      "description": "The sensor's own batch number; a batch is stored once however often it is sent"
     },
     "observations": {
      "items": {
       "$ref": "#/components/schemas/Obs"
      },
      "type": "array",
      "maxItems": 500,
      "title": "Observations"
     }
    },
    "type": "object",
    "required": [
     "seq",
     "observations"
    ],
    "title": "SyncIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}